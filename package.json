{
  "name": "mira-notes",
  "productName": "NoteMark",
  "version": "1.1.9",
  "private": true,
  "description": "Offline notes for Android and Windows with encrypted sync",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "server": "node server/cli.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test test/*.test.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "build:setup": "electron-builder --prepackaged releases/NoteMark-Windows --win nsis --x64 --publish never",
    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
